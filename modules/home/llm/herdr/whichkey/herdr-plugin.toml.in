id = "whichkey"
name = "Which-key"
version = "0.1.0"
min_herdr_version = "0.7.0"
description = "which-key style popup menu for herdr"
platforms = ["linux", "macos"]

[[actions]]
id = "open"
title = "Open which-key"
contexts = ["workspace"]
command = ["@WHICHKEY_BIN@"]

[[panes]]
id = "menu"
title = "Which-key"
placement = "popup"
width = "50%"
height = 16
command = ["@WHICHKEY_BIN@"]
