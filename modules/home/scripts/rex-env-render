#!/usr/bin/env bash
set -euo pipefail

fail() {
	printf 'rex-env-render: %s\n' "$1" >&2
	exit 1
}

[[ $# == 3 ]] || fail 'usage: rex-env-render accounts|netrc INPUT OUTPUT'
for tool in jq mktemp chmod mv; do
	command -v "$tool" >/dev/null || fail "missing command: $tool"
done
case "$1" in
accounts) key=TS_USER ;;
netrc) key=REX_PACKAGE_TOKEN ;;
*) fail 'unsupported output format' ;;
esac

# sops-nix treats dotenv secrets as whole files, not individually selected keys.
# Parse only the requested literal assignment; never source shell code or log it.
value=''
count=0
pattern="^[[:space:]]*(export[[:space:]]+)?${key}=(.*)$"
while IFS= read -r line || [[ -n "$line" ]]; do
	line="${line%$'\r'}"
	if [[ "$line" =~ $pattern ]]; then
		value="${BASH_REMATCH[2]}"
		count=$((count + 1))
	fi
done <"$2"
[[ "$count" == 1 ]] || fail "expected exactly one $key assignment"
if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
	value="${value:1:${#value}-2}"
fi
if [[ "$1" == accounts ]]; then
	[[ "$value" =~ ^[a-zA-Z0-9._+@-]+$ && "$value" == *@* ]] || fail 'TS_USER must be an exact Tailscale login, including @provider'
else
	[[ "$value" =~ ^[a-zA-Z0-9._~+/=-]+$ ]] || fail 'invalid package token format'
fi

umask 077
temporary="$(mktemp "${3}.XXXXXX")"
# Leave only an empty temporary file on failure; do not retain secret copies.
trap 'if [[ -n "$temporary" ]]; then : > "$temporary"; fi' EXIT
if [[ "$1" == accounts ]]; then
	printf '%s' "$value" | jq -Rs '
		("tailscale:" + .) as $principal |
		{version: 1, accounts: {curtbushko: {principals: [$principal, "anonymous"]}},
		 defaults: {($principal): "curtbushko", anonymous: "curtbushko"}}
	' >"$temporary"
else
	printf 'machine pkgs.superlogical.com login rex password %s\n' "$value" >"$temporary"
fi
chmod 600 "$temporary"
mv -f "$temporary" "$3"
temporary=''
