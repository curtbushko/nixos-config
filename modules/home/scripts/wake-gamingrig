#!/usr/bin/env bash
set -euo pipefail

GAMINGRIG="gamingrig"
RELAY="${RELAY_TAILNET_ID:-relay}"
CURRENT_HOST="$(hostname -s)"

function logger() {
	local TYPE=$1
	shift
	local MESSAGE="$*"
	local TIMESTAMP
	TIMESTAMP=$(date +"%Y-%m-%dT%H:%M:%SZ")
	echo "[$TIMESTAMP] [$TYPE] $MESSAGE"
}

# Read MAC address from environment or sops secrets file
MAC_ADDRESS="${GAMINGRIG_MAC_ADDRESS:-}"
if [ -z "$MAC_ADDRESS" ] && [ -f "/run/secrets/secrets.env" ]; then
	# shellcheck disable=SC1091
	source /run/secrets/secrets.env
	MAC_ADDRESS="${GAMINGRIG_MAC_ADDRESS:-}"
fi

# Check if gamingrig is already up
if ping -c 1 -W 2 "$GAMINGRIG" &>/dev/null; then
	logger INFO "Gamingrig is already up"
	exit 0
fi

# Validate MAC address is available
if [ -z "$MAC_ADDRESS" ]; then
	logger ERROR "GAMINGRIG_MAC_ADDRESS not set in environment or secrets file"
	exit 1
fi

# Wake gamingrig: LAN wake from the work laptop, bounce off relay from anywhere else.
# Failures are non-fatal — gamingrig is only a nix cache accelerator, so the
# caller (usually `task switch`) should proceed even if the wake attempt fails.
case "$CURRENT_HOST" in
	curtbushko-K4W6XK6XND)
		logger INFO "Waking gamingrig (LAN)..."
		wakeonlan "$MAC_ADDRESS" || logger WARN "wakeonlan failed (continuing)"
		;;
	*)
		logger INFO "Bouncing off of $RELAY to wake gamingrig"
		ssh root@"$RELAY" "etherwake -D -i eth0 '$MAC_ADDRESS'" \
			|| logger WARN "ssh/etherwake via $RELAY failed (continuing)"
		;;
esac

# Wait for gamingrig to come up (max 60 seconds). Never fail the caller — a
# missing cache just means a slower local build.
logger INFO "Waiting for gamingrig to respond..."
for i in {1..30}; do
	if ping -c 1 -W 2 "$GAMINGRIG" &>/dev/null; then
		logger INFO "Gamingrig is up"
		exit 0
	fi
	sleep 2
done

logger WARN "Gamingrig did not respond; continuing without cache"
exit 0
