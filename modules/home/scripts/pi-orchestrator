#!/usr/bin/env bash
set -euo pipefail

fail() {
	printf 'pi-orchestrator: %s\n' "$*" >&2
	exit 1
}

if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
	printf 'Usage: pi-orchestrator\n\nRun inside a HerdR pane in a GitHub checkout. Uses Pi for every role.\nConfiguration, prompts, database, and logs live in <repo>/.orchestrator/.\nNew pipelines leave merging to you. Pi tools are not sandboxed.\nProject-local Pi resources are ignored; global Pi settings still apply.\nCtrl-C stops the foreground daemon.\n'
	exit 0
fi
[[ $# == 0 ]] || fail 'unexpected arguments; see --help'

for command in git gh herdr pi orchestratord yq jq mkdir grep; do
	command -v "$command" >/dev/null 2>&1 || fail "missing command: $command"
done
[[ "${HERDR_ENV:-}" == 1 ]] || fail 'start herdr, then run this command in one of its panes'
herdr status >/dev/null || fail 'HerdR is not available in this pane'
pi --version >/dev/null || fail 'Pi is not available'
repo_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || fail 'current directory is not a Git checkout'
cd "$repo_dir"
remote="$(git remote get-url origin)" || fail 'checkout needs an origin remote pointing at GitHub'
gh auth status || fail 'authenticate first: gh auth login -h github.com -s repo,workflow'
repository="$(gh repo view "$remote" --json nameWithOwner,defaultBranchRef)" || fail 'cannot resolve the origin repository on GitHub'
repo="$(jq -er '.nameWithOwner' <<<"$repository")"
base="$(jq -er '.defaultBranchRef.name | select(length > 0)' <<<"$repository")" || fail 'GitHub repository needs a default branch'

state_dir="$repo_dir/.orchestrator"
config="$state_dir/pipeline.yaml"
# Keep local runtime files out of git without changing the shared .gitignore.
exclude="$(git rev-parse --git-path info/exclude)"
mkdir -p "${exclude%/*}" "$state_dir/tasks"
if ! grep -Fxq '/.orchestrator/' "$exclude" 2>/dev/null; then
	printf '\n/.orchestrator/\n' >>"$exclude"
fi

if [[ ! -e "$config" ]]; then
	orchestratord init --repo "$repo" --dir "$state_dir"
	# Pi has no built-in sandbox. Avoid unattended project-trust prompts.
	yq -i '.policies.dry_run = true | .policies.execution.sandbox = false | .roles[].launch = ["pi", "--no-approve"]' "$config"
fi
# Existing pipelines belong to the user; never silently convert Codex roles.
yq -o=json '.' "$config" | jq -e --arg repo "$repo" '
  ([.sources[] | select(.type == "github_issues")] | length) == 1
  and all(.sources[] | select(.type == "github_issues"); .repo == $repo)
  and (.roles | length > 0)
  and all(.roles[]; .launch[0] == "pi")
' >/dev/null || fail "pipeline must target $repo and use Pi for every role: $config"
orchestratord validate "$config"
label="$(yq -r '.sources[] | select(.type == "github_issues") | .select.label' "$config")"
[[ -n "$label" && "$label" != null ]] || fail 'pipeline needs a GitHub issue label'
labels="$(gh label list --repo "$repo" --limit 1000 --json name --jq '.[].name')"
if ! grep -Fxq -- "$label" <<<"$labels"; then
	gh label create "$label" --repo "$repo" --description 'Queued for the orchestrator'
fi

args=(--config "$config" --repo "$repo_dir" --base "$base" --db "$state_dir/orchestrator.db" --task-dir "$state_dir/tasks")
printf 'Repository: %s\nConfig: %s\nDry-run merging: %s\n' "$repo" "$config" "$(yq '.policies.dry_run' "$config")"
printf 'Pi tools run with your user permissions; no built-in sandbox.\n'
printf 'Running preflight (includes launching a Pi smoke-test agent).\n'
orchestratord doctor "${args[@]}"
printf 'Starting daemon; label issues "%s" to queue them. Ctrl-C stops it.\n' "$label"
exec orchestratord daemon "${args[@]}" --event-log "$state_dir/events.jsonl"
