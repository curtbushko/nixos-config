#!/usr/bin/env bash
set -euo pipefail
name="${0##*/}"
{
	printf '%s' "$name"
	printf ' %q' "$@"
	printf '\n'
} >>"$MOCK_LOG"
case "$name:$1" in
gh:auth) exit "${AUTH_STATUS:-0}" ;;
gh:repo) printf '{"nameWithOwner":"owner/project","defaultBranchRef":{"name":"develop"}}\n' ;;
gh:label)
	if [[ "$2" == list && "${LABEL_EXISTS:-false}" == true ]]; then
		printf 'agent-ready\n'
	fi
	;;
herdr:status | codex:--version | pi:--version) exit 0 ;;
orchestratord:init)
	mkdir -p "$5/prompts"
	printf 'policies:\n  dry_run: false\nsources:\n  - type: github_issues\n    repo: owner/project\n    select:\n      label: agent-ready\nroles:\n  triager:\n    launch: [claude]\n  implementer:\n    launch: [claude]\n  reviewer:\n    launch: [claude]\n' >"$5/pipeline.yaml"
	printf 'triage\n' >"$5/prompts/triage.md"
	;;
orchestratord:validate) exit 0 ;;
orchestratord:doctor) exit "${DOCTOR_STATUS:-0}" ;;
orchestratord:daemon) printf 'mock daemon started\n' ;;
*)
	printf 'unexpected mock command: %s\n' "$name" >&2
	exit 1
	;;
esac
