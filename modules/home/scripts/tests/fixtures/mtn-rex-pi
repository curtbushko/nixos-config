#!/usr/bin/env bash
set -euo pipefail
jq -cn --args '$ARGS.positional' -- "$@" >>"$FIXTURE/pi.jsonl"
[[ "${MTN_WORKFLOW_COORDINATOR:-}" != 1 ]] || [[ "${MTN_REX_ROLE:-}" == coordinator ]]
printf 'Fixture provider diagnostic\n' >&2
printf 'Fixture assistant activity\n'
result="${PI_RESULT:-}"
[[ -n "$result" ]] || result='{"outcome":"ready-for-review"}'
if [[ -n "${MTN_REX_RESULT_FILE:-}" ]]; then
	printf '%s\n' "$result" >"$MTN_REX_RESULT_FILE"
fi
printf '%s\n' "$result"
exit "${PI_EXIT:-0}"
