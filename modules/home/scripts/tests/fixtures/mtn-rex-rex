#!/usr/bin/env bash
set -euo pipefail
jq -cn --args '$ARGS.positional' -- "$@" >>"$FIXTURE/rex.jsonl"
case " $* " in
*" whoami "*)
	transport="${TRANSPORT:-unix}"
	if [[ "${DEFAULT_REMOTE:-}" == 1 && " $* " != *" -S "* ]]; then transport=tcp; fi
	jq -n --arg transport "$transport" --arg instance "${INSTANCE:-instance-1}" '{endpoint:"unix:///fixture.sock",principal:{transport:$transport},host_id:"host-1",instance_id:$instance}'
	;;
*" window new "*) printf '{"window_id":"window:worker","block_ids":["block:worker"]}\n' ;;
*" new "*)
	[[ "${FAIL_NEW:-}" != 1 ]] || exit 1
	printf '{"session_id":"session:parent","initial_windows":[{"window_id":"window:coord","block_ids":["block:coord"]}]}\n'
	;;
*" session inspect "*) printf '{"session_id":"session:parent"}\n' ;;
*" block call "*) printf '{"running":true}\n' ;;
*) exit 1 ;;
esac
