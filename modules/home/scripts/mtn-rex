#!/usr/bin/env bash
set -euo pipefail

fail() {
	printf 'mtn-rex: %s\n' "$*" >&2
	exit 1
}
for tool in jq git dirname basename mkdir sleep cp; do
	command -v "$tool" >/dev/null || fail "$tool is required"
done
lib="${MTN_REX_LIB:-$(dirname "${BASH_SOURCE[0]}")/../llm/skills/mtn-tasks/scripts}"
self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
repo=''
if [[ "${1:-}" == --repo ]]; then
	repo="${2:?repository required}"
	shift 2
fi
command="${1:-help}"
shift || true

# Run on the execution host. Never SSH a local worktree path or trust Rex's home-server default.
workflow() { mtn-workflow --repo "$repo" "$@"; }
publish() {
	workflow publish "$1" | jq -e '.ok == true' >/dev/null || fail 'mtn publication failed; preserve transport and inspect before retrying'
}
lookup() {
	local snapshot
	snapshot="$(workflow snapshot "$1")"
	jq -ce --arg run "$2" '[.events[] | select(.kind=="runtime" and .stage=="launched" and .runId==$run)] | last // error("No persisted Rex launch for that run")' <<<"$snapshot"
}
label_slug() {
	jq -ner --arg label "$1" '$label | ascii_downcase | gsub("[^a-z0-9]+";"-") | sub("^-+";"") | sub("-+$";"") | select(length>0)'
}
stable_phase_number() {
	local ref="$1" stem suffix number
	stem="${ref##*/}"
	stem="${stem%.md}"
	if [[ "$stem" == "$project_name-"* ]]; then
		suffix="${stem#"$project_name-"}"
		if [[ "$suffix" =~ ^([0-9]+)(-|$) ]]; then
			number="$((10#${BASH_REMATCH[1]}))"
			((number > 0)) || fail "phase ref has an invalid stable number: $ref"
			printf '%s\n' "$number"
			return
		fi
	fi
	jq -er '.phaseNumber | select(type=="number" and .>=1 and floor==.)' <<<"$request" ||
		fail "phase ref has no stable numeric identity; provide phaseNumber explicitly: $ref"
}
stable_task_number() {
	local ref="$1" stem suffix number
	stem="${ref##*/}"
	stem="${stem%.md}"
	if [[ "$stem" == "$project_name-"* ]]; then
		suffix="${stem#"$project_name-"}"
		if [[ "$suffix" =~ ^[0-9]+-([0-9]+)(-|$) ]]; then
			number="$((10#${BASH_REMATCH[1]}))"
			((number > 0)) || fail "task ref has an invalid stable number: $ref"
			printf '%s\n' "$number"
			return
		fi
	fi
	jq -er '.taskNumber | select(type=="number" and .>=1 and floor==.)' <<<"$request" ||
		fail "task ref has no stable numeric identity; provide taskNumber explicitly: $ref"
}
pin_host() {
	local endpoint="$1" host="$2" instance="$3" identity
	identity="$(rex --autostart=false -S "$endpoint" whoami --json)"
	jq -e --arg host "$host" --arg instance "$instance" '.principal.transport=="unix" and .host_id==$host and .instance_id==$instance' <<<"$identity" >/dev/null || fail 'Rex host/server instance changed; inspect, do not relaunch'
}

agent() {
	local dir="$1" request role run prompt model thinking i code=0 finish_extension
	[[ "$dir" == /* && -f "$dir/request.json" && -f "$dir/context.json" ]] || fail 'absolute transport directory with launch context required'
	# Rex's server may predate the user's activated Nix profile. Restore the launching
	# host's command search path, without copying credentials or the whole environment.
	PATH="$(jq -er '.path | select(type=="string" and length>0)' "$dir/context.json")"
	export PATH
	command -v pi >/dev/null || fail 'pi is unavailable on the saved launch PATH'
	# A bounded startup gate, not session/log polling. Publication must finish before Pi can write.
	for ((i = 0; i < 60; i++)); do
		[[ ! -f "$dir/ready" ]] || break
		sleep 1
	done
	[[ -f "$dir/ready" ]] || fail 'launch was not published; startup gate timed out'
	request="$(jq -ce -L "$lib" 'include "workflow"; select(rex_request)' "$dir/request.json")"
	relocation="$(jq -c '.collectionRelocation // empty' <<<"$request")"
	if [[ -n "$relocation" ]]; then
		relocation_from="$(jq -r .fromRoot <<<"$relocation")"
		relocation_approved_by="$(jq -r .approvedBy <<<"$relocation")"
		relocation_reason="$(jq -r .reason <<<"$relocation")"
		export MTN_WORKFLOW_ALLOW_RELOCATED_COLLECTION=true
		export MTN_WORKFLOW_RELOCATION_FROM="$relocation_from"
		export MTN_WORKFLOW_RELOCATION_APPROVED_BY="$relocation_approved_by"
		export MTN_WORKFLOW_RELOCATION_REASON="$relocation_reason"
	fi
	role="$(jq -r .role <<<"$request")"
	run="$(jq -r .runId <<<"$request")"
	model="$(jq -r .model <<<"$request")"
	thinking="$(jq -r .thinking <<<"$request")"
	prompt="$(jq -r .prompt <<<"$request")"
	prompt+=$'\nLaunch contract: '
	prompt+="$(jq -c 'del(.prompt)' <<<"$request")"
	prompt+=$'\nParent collection checkout: '
	prompt+="$(jq -r .repo "$dir/context.json")"
	prompt+=$'\nRuntime identity: '
	prompt+="$(jq -ce --arg run "$run" 'select(.stage=="launched" and .piSessionId==$run) | {runId,piSessionId,piSessionName:(.piSessionName // .windowName),rexSessionId,rexSessionName:(.rexSessionName // .sessionName),rexWindowId,rexWindowName:(.rexWindowName // .windowName),rexBlockId,host}' "$dir/persisted.json")"
	cd "$(jq -r .worktree <<<"$request")"
	export MTN_REX_ROLE="$role" MTN_REX_RUN_ID="$run" MTN_REX_REPO
	MTN_REX_REPO="$(jq -r .repo "$dir/context.json")"
	unset MTN_WORKFLOW_COORDINATOR MTN_REX_COORDINATOR_RUN
	local args=(--session-id "$run" --name "$(jq -r '.piSessionName // .windowName' "$dir/context.json")" --model "$model" --thinking "$thinking")
	if [[ "$role" == coordinator ]]; then
		export MTN_WORKFLOW_COORDINATOR=1 MTN_REX_COORDINATOR_RUN="$run"
		prompt="Keep terminal output concise: report only dispatch, completion, blockers and decisions. Never echo task Markdown, full descriptions, prompts or evidence payloads. Write record/request content directly to files with quiet tool calls; redirect mtn mutation output to private transport files and inspect only the needed status fields. Your interactive tool calls are visible, so do not embed full record bodies in displayed commands. You are the sole handed-off coordinator. Your Rex session/window and Pi conversation already exist; use the supplied runtime IDs, never display names, to address them. Do not create another Rex session or coordinator Pi conversation. Launch leaf agents only through mtn-rex as new Rex windows in this Rex session. Read the team skill and mtn-tasks Rex execution reference, then reconcile the supplied phase and persisted runtime evidence before dispatch. $prompt"
		pi "${args[@]}" -- "$prompt" || code=$?
	else
		result_file="$dir/final-result.json"
		finish_extension="$dir/finish-on-result.mjs"
		printf '%s\n' \
			'import { readFileSync } from "node:fs";' \
			'' \
			'export default function (pi) {' \
			'  pi.on("agent_before_settle", (_event, ctx) => {' \
			'    const path = process.env.MTN_REX_RESULT_FILE;' \
			'    if (!path) return;' \
			'    try {' \
			'      const result = JSON.parse(readFileSync(path, "utf8"));' \
			'      if (result && typeof result === "object" && result.schemaVersion === 1 && typeof result.eventId === "string" && typeof result.recordRef === "string") {' \
			'        ctx.shutdown();' \
			'      }' \
			'    } catch {}' \
			'  });' \
			'}' >"$finish_extension"
		export MTN_REX_RESULT_FILE="$result_file"
		args+=(--extension "$finish_extension")
		prompt="You are a leaf $role using the $run run identity. Your Rex window and Pi conversation already exist; do not create or resume sessions/windows. Rex resource IDs and your Pi session ID are separate identities. Read mtn-tasks worker contract and the assigned skill. Never write mtn records, integrate, or launch agents. Keep working activity visible in this Rex terminal. Before your final response, write exactly one machine-readable protocol JSON object to the absolute final-result file $result_file; do not write progress, Markdown, or multiple objects there. Then return that same JSON object as your final response without Markdown fences. Once the final result is written and the final agent turn settles, the launcher will request an orderly Pi shutdown. $prompt"
		printf 'mtn-rex: %s started\n' "$run"
		set +e
		pi "${args[@]}" -- "$prompt"
		code=$?
		set -e
		if [[ "$code" == 0 && -s "$result_file" ]]; then
			cp "$result_file" "$dir/result.json"
		fi
	fi
	# Persist evidence before closing our own window; never close the coordinator.
	printf '%s\n' "$code" >"$dir/exit-code"
	if [[ "$role" != coordinator ]]; then
		if [[ "$code" == 0 ]] && jq -se 'length==1 and (.[0] | type=="object" and .outcome!="blocked" and .outcome!="failed" and .verdict!="CHANGES_NEEDED")' "$dir/result.json" >/dev/null 2>&1; then
			printf 'mtn-rex: %s finished; evidence: %s\n' "$run" "$dir"
			local endpoint host instance session window
			endpoint="$(jq -r .host.endpoint "$dir/persisted.json")"
			host="$(jq -r .host.hostId "$dir/persisted.json")"
			instance="$(jq -r .host.instanceId "$dir/persisted.json")"
			session="$(jq -r .rexSessionId "$dir/persisted.json")"
			window="$(jq -r .rexWindowId "$dir/persisted.json")"
			if ! (command -v rex >/dev/null && pin_host "$endpoint" "$host" "$instance" &&
				rex --autostart=false -S "$endpoint" window close -s "$session" "$window"); then
				printf 'mtn-rex: could not close %s; inspect Rex state and transport %s\n' "$run" "$dir" >&2
			fi
		else
			printf 'mtn-rex: %s needs attention (exit %s); retained window; evidence: %s\n' "$run" "$code" "$dir" >&2
		fi
	fi
	return "$code"
}

case "$command" in
help | --help | -h)
	printf 'Usage: mtn-rex --repo COLLECTION_CHECKOUT launch REQUEST.json\n'
	printf '       mtn-rex --repo COLLECTION_CHECKOUT inspect|result RECORD_REF RUN_ID\n'
	printf 'Run locally on the execution host. Only the authorized coordinator may launch.\n'
	exit 0
	;;
agent)
	agent "${1:?transport directory required}"
	exit
	;;
launch | inspect | result) ;;
*) fail "unknown command: $command" ;;
esac
[[ -n "$repo" ]] || fail '--repo is required'
repo="$(cd "$repo" && pwd -P)"
[[ "$repo" == "$(git -C "$repo" rev-parse --show-toplevel)" ]] || fail '--repo must be the canonical collection checkout root'
for tool in mtn-workflow rex; do command -v "$tool" >/dev/null || fail "$tool is required"; done

if [[ "$command" != launch ]]; then
	event="$(lookup "${1:?record ref required}" "${2:?run ID required}")"
	endpoint="$(jq -r .host.endpoint <<<"$event")"
	pin_host "$endpoint" "$(jq -r .host.hostId <<<"$event")" "$(jq -r .host.instanceId <<<"$event")"
	if [[ "$command" == result ]]; then
		dir="$(jq -r .transportDir <<<"$event")"
		[[ "$dir" == "$repo/.mtn-tmp/rex/$(jq -r .runId <<<"$event")" && ! -L "$dir" ]] || fail 'unexpected transport path'
		[[ "$(<"$dir/exit-code")" == 0 ]] || fail 'worker has not exited successfully'
		jq -ce 'select(type=="object")' "$dir/result.json"
	else
		rex --autostart=false -S "$endpoint" block call -s "$(jq -r .rexSessionId <<<"$event")" -b "$(jq -r .rexBlockId <<<"$event")" process
	fi
	exit
fi

[[ "${MTN_WORKFLOW_COORDINATOR:-}" == 1 ]] || fail 'launch is coordinator-only'
command -v pi >/dev/null || fail 'pi is required on the execution host'
request="$(jq -ce -L "$lib" 'include "workflow"; select(rex_request)' "${1:?request JSON file required}")" || fail 'invalid launch request'
relocation="$(jq -c '.collectionRelocation // empty' <<<"$request")"
if [[ -n "$relocation" ]]; then
	jq -e '(.fromRoot | type == "string" and startswith("/")) and
		(.fromRunId | type == "string" and length > 0) and
		(.approvedBy | type == "string" and length > 0) and
		(.reason | type == "string" and length > 0)' <<<"$relocation" >/dev/null ||
		fail 'collection relocation requires fromRoot, fromRunId, approvedBy and reason'
	relocation_from="$(jq -r .fromRoot <<<"$relocation")"
	relocation_approved_by="$(jq -r .approvedBy <<<"$relocation")"
	relocation_reason="$(jq -r .reason <<<"$relocation")"
	export MTN_WORKFLOW_ALLOW_RELOCATED_COLLECTION=true
	export MTN_WORKFLOW_RELOCATION_FROM="$relocation_from"
	export MTN_WORKFLOW_RELOCATION_APPROVED_BY="$relocation_approved_by"
	export MTN_WORKFLOW_RELOCATION_REASON="$relocation_reason"
fi
ref="$(jq -r .recordRef <<<"$request")"
run="$(jq -r .runId <<<"$request")"
role="$(jq -r .role <<<"$request")"
worktree="$(cd "$(jq -r .worktree <<<"$request")" && pwd -P)"
[[ "$worktree" == "$(git -C "$worktree" rev-parse --show-toplevel)" ]] || fail 'worktree must be a Git checkout root'
[[ "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)" == "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)" ]] || fail 'worktree belongs to another repository'
snapshot="$(workflow snapshot "$ref")"
hash="$(jq -r .specHash <<<"$snapshot")"
[[ "$hash" == "$(jq -r .specHash <<<"$request")" ]] || fail 'stale specification'
jq -e --arg run "$run" 'all(.events[]; .kind!="runtime" or .runId!=$run)' <<<"$snapshot" >/dev/null || fail 'run already reserved; inspect persisted evidence, never duplicate launch'
kind="$(jq -r .kind <<<"$snapshot")"
server="$(jq -r '.server // empty' <<<"$request")"
if [[ "$role" != coordinator ]]; then
	phase="$(jq -r .phaseRef <<<"$request")"
	parent_run="$(jq -r .parentRunId <<<"$request")"
	[[ "${MTN_REX_COORDINATOR_RUN:-}" == "$parent_run" ]] || fail 'only the handed-off coordinator may dispatch workers'
	parent="$(lookup "$(jq -r '.coordinatorPhaseRef // .phaseRef' <<<"$request")" "$parent_run")"
	server="$(jq -r .host.endpoint <<<"$parent")"
fi
rex_args=(--autostart=false)
[[ -z "$server" ]] || rex_args+=(-S "$server")
identity="$(rex "${rex_args[@]}" whoami --json)"
jq -e '.principal.transport=="unix" and (.endpoint|startswith("unix://"))' <<<"$identity" >/dev/null || fail 'Rex must be local to this execution host; choose its Unix endpoint explicitly via request.server'
host="$(jq -c '{endpoint,hostId:.host_id,instanceId:.instance_id}' <<<"$identity")"
endpoint="$(jq -r .endpoint <<<"$host")"
rex_args=(--autostart=false -S "$endpoint")
session=''
# The common Git directory identifies the project even in a linked worktree.
project_dir="$(dirname "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)")"
project_name="$(label_slug "${project_dir##*/}")" || fail 'project directory needs an ASCII letter or digit for its label'
if [[ "$role" == coordinator ]]; then
	[[ "$kind" == phase && -z "${MTN_REX_COORDINATOR_RUN:-}" ]] || fail 'coordinator handoff requires a phase and an unhanded-off caller'
	command -v mtn >/dev/null || fail 'mtn is required'
	# Coordinator ownership is phase-local. A deliberate transfer changes the
	# host-sticky phase owner while preserving the prior runtime reservation.
	transfer_run="$(jq -r '.fromRunId // empty' <<<"$relocation")"
	prior="$(workflow snapshot "$ref")"
	jq -e --arg transfer_run "$transfer_run" '.events as $events |
		all($events[]; . as $event |
			if .kind=="runtime" and .role=="coordinator" and .stage=="reserved" then
				(any($events[]; .kind=="release" and .dispatchEventId==$event.eventId) or
				 ($transfer_run != "" and .runId==$transfer_run))
			else true end)' <<<"$prior" >/dev/null ||
		fail "unreleased coordinator in selected phase; reconcile or provide an explicit ownership transfer"
	worktree_name="$(label_slug "${worktree##*/}")" || fail 'worktree directory needs an ASCII letter or digit for its label'
	if [[ "$role" != coordinator && "$worktree" != "$project_dir" ]]; then
		[[ "$worktree_name" == "$display_name" ]] || fail "worker worktree name must match its Rex/Pi display name: $display_name"
	fi
	session_name="$project_name-$worktree_name"
	[[ "$project_dir" != "$worktree" ]] || session_name="$project_name"
	phase_number="$(stable_phase_number "$ref")"
	printf -v canonical_name '%s-p%02d-coordinator-a%02d' "$project_name" "$phase_number" "$(jq -r .attempt <<<"$request")"
	display_name=coordinator
else
	jq -e --argjson host "$host" '.role=="coordinator" and .host==$host' <<<"$parent" >/dev/null || fail 'parent belongs to another host/server instance'
	if [[ "$role" == planner ]]; then
		[[ "$kind" == phase && "$ref" == "$phase" ]] || fail 'planner must be attached to its parent phase'
	else
		[[ "$kind" == task ]] || fail 'builder/reviewer requires an implementation task'
		command -v mtn >/dev/null || fail 'mtn is required'
		mtn --path "$repo/.tasks" agent hierarchy "$ref" --json | jq -e --arg phase "$phase" '.ok and any(.result.parents[]; .resolution.ref==$phase)' >/dev/null || fail 'task is not in that phase'
		jq -e --arg id "$(jq -r .dispatchEventId <<<"$request")" --arg hash "$hash" --argjson attempt "$(jq .attempt <<<"$request")" 'any(.events[]; .kind=="dispatch" and .eventId==$id and .specHash==$hash and .attempt==$attempt)' <<<"$snapshot" >/dev/null || fail 'matching dispatch must be published before worker launch'
	fi
	session="$(jq -r .rexSessionId <<<"$parent")"
	rex "${rex_args[@]}" session inspect "$session" --json >/dev/null
	session_name="$(jq -r '.rexSessionName // .sessionName' <<<"$parent")"
	if [[ "$role" == planner ]]; then
		phase_number="$(stable_phase_number "$ref")"
		printf -v canonical_name '%s-p%02d-planner-a%02d' "$project_name" "$phase_number" "$(jq -r .attempt <<<"$request")"
		display_name="$canonical_name"
	else
		phase_number="$(stable_phase_number "$phase")"
		task_number="$(stable_task_number "$ref")"
		agent_label="$role"
		if [[ "$role" == reviewer ]]; then
			skill="$(jq -r .skill <<<"$request")"
			agent_label="${skill#*-}"
		fi
		printf -v canonical_name '%s-p%02d-t%02d-%s-a%02d' "$project_name" "$phase_number" "$task_number" "$agent_label" "$(jq -r .attempt <<<"$request")"
		display_name="$canonical_name"
	fi
fi
[[ "$run" == "$canonical_name" ]] || fail "runId must match the canonical agent identity: $canonical_name"
[[ ${#canonical_name} -le 100 ]] || fail 'canonical agent identity exceeds the 100-character Pi run ID limit'
# Display labels are presentation only; durable run/Pi IDs remain canonical.
if [[ "$role" != coordinator ]]; then
	display_name="${display_name#"$project_name-"}"
fi
window_name="$display_name"
[[ ${#session_name} -le 128 ]] || fail 'Rex session label exceeds 128 characters'
# Git ignores transport, while mtn evidence is the sole authoritative run index.
git -C "$repo" check-ignore -q --no-index .mtn-tmp/rex/ || fail 'exclude .mtn-tmp/ from Git before launch'
[[ ! -L "$repo/.mtn-tmp" && ! -L "$repo/.mtn-tmp/rex" ]] || fail 'transport directory cannot be a symlink'
mkdir -p "$repo/.mtn-tmp/rex"
dir="$repo/.mtn-tmp/rex/$run"
(
	umask 077
	mkdir "$dir"
) || fail 'transport already exists; inspect before recovery'
printf '%s\n' "$request" >"$dir/request.json"
event="$(jq -c --arg run "$run" --arg dir "$dir" --arg window "$window_name" --arg session "$session_name" --arg worktree "$worktree" --argjson host "$host" '. + {schemaVersion:1,eventId:($run+"/runtime/reserved"),kind:"runtime",stage:"reserved",piSessionId:$run,transportDir:$dir,worktree:$worktree,host:$host,rexSessionName:$session,rexWindowName:$window,piSessionName:$window,sessionName:$session,windowName:$window} | del(.prompt,.server)' <<<"$request")"
# Keep prompts in transport, not durable notes. The event schema validates the launch metadata.
printf '%s\n' "$event" >"$dir/reserved.json"
publish "$dir/reserved.json"
jq -n --arg repo "$repo" --arg window "$window_name" --arg path "$PATH" '{repo:$repo,piSessionName:$window,windowName:$window,path:$path}' >"$dir/context.json"
if [[ "$role" == coordinator ]]; then
	rex "${rex_args[@]}" new "$session_name" -c "$worktree" --window "$window_name" --keep-open --shell=none --json -- bash "$self" agent "$dir" >"$dir/created.json"
	ids="$(jq -ce '{rexSessionId:.session_id,rexWindowId:.initial_windows[0].window_id,rexBlockId:.initial_windows[0].block_ids[0]}' "$dir/created.json")"
else
	rex "${rex_args[@]}" window new -s "$session" "$window_name" -c "$worktree" --keep-open --focus=false --shell=none --json -- bash "$self" agent "$dir" >"$dir/created.json"
	ids="$(jq -ce --arg session "$session" '{rexSessionId:$session,rexWindowId:.window_id,rexBlockId:.block_ids[0]}' "$dir/created.json")"
fi
jq -c --arg run "$run" --argjson ids "$ids" '. + $ids + {eventId:($run+"/runtime/launched"),stage:"launched"}' "$dir/reserved.json" >"$dir/launched.json"
publish "$dir/launched.json"
# Confirm persistence before allowing this new Pi to mutate anything.
lookup "$ref" "$run" >"$dir/persisted.json"
[[ "$(jq -Sc . "$dir/launched.json")" == "$(jq -Sc . "$dir/persisted.json")" ]] || fail 'launch readback mismatch; startup remains gated'
printf 'ready\n' >"$dir/ready"
printf '%s\n' "$(<"$dir/launched.json")"
